    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "cssnano": "^8.0.8",
    "html-validate": "^11.17.0",
    "husky": "^9.1.7",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0"
  }
